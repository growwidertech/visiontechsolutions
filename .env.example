# ============================================================================
# VISION TECH SOLUTIONS - ENVIRONMENT CONFIGURATION
# ============================================================================

# Server Configuration
NODE_ENV=development
PORT=5000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_SITE_URL=https://visiontechsolutions.co.in
FRONTEND_URL=https://visiontechsolutions.co.in

# MongoDB Configuration
# If local MongoDB is not running, the backend supports an automatic persistent embedded MongoDB fallback for zero-config local execution
MONGODB_URI=mongodb://127.0.0.1:27017/visiontechsolutions

# Authentication & Security
JWT_SECRET=vision-tech-super-secret-jwt-key-2026-production-grade
JWT_REFRESH_SECRET=vision-tech-super-secret-refresh-key-2026-production
JWT_EXPIRES_IN=8h
COOKIE_SECRET=vision-tech-cookie-secret-2026

# Cloudinary Media Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=vision-tech-solutions

# Email (Nodemailer SMTP Configuration)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notifications@visiontechsolutions.co.in
SMTP_PASS=your_smtp_app_password
COMPANY_NOTIFICATION_EMAIL=info@visiontechsolutions.co.in

# Default Super Admin Seed Credentials
ADMIN_EMAIL=admin@visiontechsolutions.co.in
ADMIN_PASSWORD=Admin@123456
