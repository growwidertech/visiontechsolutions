{
  "name": "vision-interiors",
  "version": "1.0.0",
  "private": true,
  "description": "Vision Tech Solutions – Premium Interior Design Website & Complete CMS",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,yellow\" \"npm run dev --workspace=@vision/backend\" \"npm run dev --workspace=@vision/frontend\"",
    "dev:backend": "npm run dev --workspace=@vision/backend",
    "dev:frontend": "npm run dev --workspace=@vision/frontend",
    "build": "npm run build --workspace=@vision/shared && npm run build --workspace=@vision/backend && npm run build --workspace=@vision/frontend",
    "start": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,yellow\" \"npm run start --workspace=@vision/backend\" \"npm run start --workspace=@vision/frontend\"",
    "seed": "npm run seed --workspace=@vision/backend",
    "test": "npm run test --workspace=@vision/backend"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "typescript": "^5.6.3"
  }
}
